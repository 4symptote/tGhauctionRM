<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="mainContentVBox" alignment="TOP_CENTER" spacing="40.0" styleClass="root-pane" stylesheets="@../css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.client.controller.AdminDashboardController">
    <padding>
        <Insets bottom="50.0" left="80.0" right="80.0" top="50.0" />
    </padding>

    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #c0392b;" text="not enough admin" />

    <VBox maxWidth="600.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Force Delete Auction" />
        <Label style="-fx-text-fill: #7f8c8d;" wrapText="true" />
        <HBox spacing="15.0">
            <TextField fx:id="auctionIdField" promptText="Enter exact Auction ID..." styleClass="form-input" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleDeleteAuction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;" text="NUKE AUCTION" />
        </HBox>
    </VBox>

    <VBox maxWidth="600.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Terminate User Account" />
        <Label style="-fx-text-fill: #7f8c8d;" wrapText="true" />
        <HBox spacing="15.0">
            <TextField fx:id="userIdField" promptText="Enter exact User ID..." styleClass="form-input" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleDeleteUser" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;" text="BAN USER" />
        </HBox>
    </VBox>
</VBox>
