<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="wallet-pane" stylesheets="@../css/global.css, @../css/wallet.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.client.controller.WalletController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label styleClass="wallet-title" text="Wallet" />

    <VBox alignment="CENTER" spacing="5.0">
        <Label fx:id="currentBalanceLabel" styleClass="wallet-balance" text="Available: $0.00" />
        <Label fx:id="roleWarningLabel" styleClass="wallet-subtitle" text="(Bidders can deposit, Sellers can withdraw)" wrapText="true" textAlignment="CENTER"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Label styleClass="dollar-sign" text="\$" />
        <TextField fx:id="amountField" prefWidth="150.0" promptText="Enter amount..." styleClass="form-input" />
    </HBox>

    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="depositBtn" onAction="#handleDeposit" prefWidth="120.0" styleClass="action-btn, deposit-btn" text="Deposit" />
        <Button fx:id="withdrawBtn" onAction="#handleWithdraw" prefWidth="120.0" styleClass="action-btn, withdraw-btn" text="Withdraw" />
    </HBox>
</VBox>